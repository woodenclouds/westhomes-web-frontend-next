# mock | api — flip to api when real CMS endpoints are ready
CMS_MODE=mock

# Public site URL (SEO canonicals / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CMS API base URL (used when CMS_MODE=api)
NEXT_PUBLIC_CMS_API_URL=

# WhatsApp business number in international format without + (e.g. 971501234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=971501234567

# Optional: contact details override (mock content also provides these)
NEXT_PUBLIC_CONTACT_PHONE=+971 50 123 4567
NEXT_PUBLIC_CONTACT_EMAIL=hello@westhomefurniture.ae
