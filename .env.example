# mock | api — use api to read/write against WoQuick public CMS
CMS_MODE=mock

# Public site URL (SEO canonicals / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WoQuick tenant public API (server-preferred; used when CMS_MODE=api)
CMS_API_BASE=https://west-homes.api.woquick.in/api/v1/cms/public

# Optional legacy alias for CMS_API_BASE
# NEXT_PUBLIC_CMS_API_URL=https://west-homes.api.woquick.in/api/v1/cms/public

# Server-only token for private CMS reads / MCP (never commit real values)
# WOQUICK_CMS_TOKEN=wqcms_...
# CMS_API_TOKEN=wqcms_...

# WhatsApp business number in international format without + (e.g. 971558708760)
NEXT_PUBLIC_WHATSAPP_NUMBER=971558708760

# Optional: contact details override (CMS contact entry also provides these)
NEXT_PUBLIC_CONTACT_PHONE=+971 55 870 8760
NEXT_PUBLIC_CONTACT_EMAIL=hello@westhomedubai.ae
